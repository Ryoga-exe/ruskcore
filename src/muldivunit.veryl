import eei::*;

module muldivunit (
    clk    : input  clock   ,
    rst    : input  reset   ,
    ready  : output logic   ,
    valid  : input  logic   ,
    funct3 : input  logic<3>,
    is_op32: input  logic   ,
    op1    : input  UIntX   ,
    op2    : input  UIntX   ,
    rvalid : output logic   ,
    result : output UIntX   ,
) {
    enum State {
        Idle,
        WaitValid,
    }

    var state: State;

    // saved_data
    var funct3_saved : logic<3>;
    var is_op32_saved: logic   ;
    var op1sign_saved: logic   ;
    var op2sign_saved: logic   ;

    // utils
    function abs::<WIDTH: u32> (
        value: input logic<WIDTH>,
    ) -> logic<WIDTH> {
        return if value[msb] ? ~value + 1 : value;
    }

    function sext::<WIDTH_IN: u32, WIDTH_OUT: u32> (
        value: input logic<WIDTH_IN>,
    ) -> logic<WIDTH_OUT> {
        return {value[msb] repeat WIDTH_OUT - WIDTH_IN, value};
    }

    // multiply unit
    const MUL_OP_WIDTH: u32 = XLEN;

    let is_mul     : logic       = if state == State::Idle ? !funct3[2] : !funct3_saved[2];
    var mu_rvalid  : logic      ;
    var mu_result  : logic<XLEN>;
    var mu_low_zero: logic      ;

    let mu_op1: logic<MUL_OP_WIDTH> = case funct3[1:0] {
        2'b00, 2'b01, 2'b10: abs::<XLEN>(if is_op32 ? sext::<32, XLEN>(op1[31:0]) : op1), // MUL, MULH, MULHSU, MULW
        2'b11              : op1, // MULHU
        default            : 0,
    };
    let mu_op2: logic<MUL_OP_WIDTH> = case funct3[1:0] {
        2'b00, 2'b01: abs::<XLEN>(if is_op32 ? sext::<32, XLEN>(op2[31:0]) : op2), // MUL, MULH, MULW
        2'b11, 2'b10: op2, // MULHU, MULHSU
        default     : 0,
    };
    let mu_high: logic = funct3[1:0] != 2'b00;

    inst mu: mulunit #(
        WIDTH: MUL_OP_WIDTH,
    ) (
        clk                               ,
        rst                               ,
        valid   : ready && valid && is_mul,
        op1     : mu_op1                  ,
        op2     : mu_op2                  ,
        high    : mu_high                 ,
        rvalid  : mu_rvalid               ,
        result  : mu_result               ,
        low_zero: mu_low_zero             ,
    );

    // divider unit
    const DIV_WIDTH: u32 = XLEN;

    var du_rvalid   : logic           ;
    var du_quotient : logic<DIV_WIDTH>;
    var du_remainder: logic<DIV_WIDTH>;

    function generate_div_op (
        is_op32: input logic      ,
        funct3 : input logic<3>   ,
        value  : input logic<XLEN>,
    ) -> logic<DIV_WIDTH> {
        return case funct3[1:0] {
            2'b00, 2'b10: abs::<DIV_WIDTH>(if is_op32 ? sext::<32, DIV_WIDTH>(value[31:0]) : value), // DIV, REM
            2'b01, 2'b11: if is_op32 ? {1'b0 repeat DIV_WIDTH - 32, value[31:0]} : value, // DIVU, REMU
            default     : 0,
        };
    }
    let du_dividend: logic<DIV_WIDTH> = generate_div_op(is_op32, funct3, op1);
    let du_divisor : logic<DIV_WIDTH> = generate_div_op(is_op32, funct3, op2);

    var du_signed_overflow: logic;
    var du_signed_divzero : logic;
    var du_signed_error   : logic;
    always_comb {
        if is_op32 {
            du_signed_overflow = !funct3[0] && op1[31] == 1 && op1[31 - 1:0] == 0 && &op2[31:0];
            du_signed_divzero  = !funct3[0] && op2[31:0] == 0;
        } else {
            du_signed_overflow = !funct3[0] && op1[msb] == 1 && op1[msb - 1:0] == 0 && &op2;
            du_signed_divzero  = !funct3[0] && op2 == 0;
        }
        du_signed_error = du_signed_overflow || du_signed_divzero;
    }

    inst du: divunit #(
        WIDTH: DIV_WIDTH,
    ) (
        clk                                                     ,
        rst                                                     ,
        valid    : ready && valid && !is_mul && !du_signed_error,
        dividend : du_dividend                                  ,
        divisor  : du_divisor                                   ,
        rvalid   : du_rvalid                                    ,
        quotient : du_quotient                                  ,
        remainder: du_remainder                                 ,
    );

    // state
    always_comb {
        ready = (state == State::Idle);
    }

    always_ff {
        if_reset {
            state         = State::Idle;
            result        = 0;
            funct3_saved  = 0;
            is_op32_saved = 0;
            op1sign_saved = 0;
            op2sign_saved = 0;
            rvalid        = 0;
        } else {
            rvalid = 0;
            case state {
                State::Idle     : if ready && valid {
                    funct3_saved  = funct3;
                    is_op32_saved = is_op32;
                    op1sign_saved = if is_op32 ? op1[31] : op1[msb];
                    op2sign_saved = if is_op32 ? op2[31] : op2[msb];

                    if is_mul {
                        state = State::WaitValid;
                    } else {
                        // div ad-hoc proc
                        if du_signed_overflow {
                            state  = State::Idle;
                            rvalid = 1;
                            result = if funct3[1] ?
                                0
                            :
                                (if is_op32 ? sext::<32, XLEN>(op1[31:0]) : {1'b1, 1'b0 repeat XLEN - 1})
                            ; // REM : DIV
                        } else if du_signed_divzero {
                            state  = State::Idle;
                            rvalid = 1;
                            result = if funct3[1] ? (if is_op32 ? sext::<32, 64>(op1[31:0]) : op1) : '1; // REM : DIV
                        } else {
                            state = State::WaitValid;
                        }
                    }
                }
                State::WaitValid: if is_mul && mu_rvalid {
                    let negate_carry  : logic<XLEN> = if funct3_saved[1:0] == 2'b00 ?
                        1
                    :
                        {1'b0 repeat XLEN - 1, mu_low_zero}
                    ;
                    let negated_result: logic<XLEN> = ~mu_result + negate_carry;
                    let res_signed    : logic<XLEN> = if op1sign_saved != op2sign_saved ? negated_result : mu_result;
                    let res_mulhsu    : logic<XLEN> = if op1sign_saved ? negated_result : mu_result;

                    state  = State::Idle;
                    rvalid = 1;
                    result = case funct3_saved[1:0] {
                        2'b00  : if is_op32_saved ? sext::<32, 64>(res_signed[31:0]) : res_signed, // MUL, MULW
                        2'b01  : res_signed, // MULH
                        2'b10  : res_mulhsu, // MULHSU
                        2'b11  : mu_result, // MULHU
                        default: 0,
                    };
                } else if !is_mul && du_rvalid {
                    // div is done
                    let quo_signed: logic<DIV_WIDTH> = if op1sign_saved != op2sign_saved ?
                        ~du_quotient + 1
                    :
                        du_quotient
                    ;
                    let rem_signed: logic<DIV_WIDTH> = if op1sign_saved == 1 ? ~du_remainder + 1 : du_remainder;
                    let resultX   : UIntX            = case funct3_saved[1:0] {
                        2'b00  : quo_signed[XLEN - 1:0], // DIV
                        2'b01  : du_quotient[XLEN - 1:0], // DIVU
                        2'b10  : rem_signed[XLEN - 1:0], // REM
                        2'b11  : du_remainder[XLEN - 1:0], // REMU
                        default: 0,
                    };
                    state  = State::Idle;
                    rvalid = 1;
                    result = if is_op32_saved ? sext::<32, 64>(resultX[31:0]) : resultX;
                }
                default: {}
            }
        }
    }
}

module mulunit #(
    param WIDTH: u32 = XLEN,
) (
    clk     : input  clock       ,
    rst     : input  reset       ,
    valid   : input  logic       ,
    op1     : input  logic<WIDTH>,
    op2     : input  logic<WIDTH>,
    high    : input  logic       ,
    rvalid  : output logic       ,
    result  : output logic<WIDTH>,
    low_zero: output logic       ,
) {
    enum State {
        Idle,
        AddLoop,
    }

    var state: State;

    const BOOTH_WIDTH: u32 = WIDTH + 3 - WIDTH % 3;
    const ACC_WIDTH  : u32 = BOOTH_WIDTH + 3;
    const ITERATIONS : u32 = BOOTH_WIDTH / 3;

    let extended_op1: logic<ACC_WIDTH> = {1'b0 repeat ACC_WIDTH - WIDTH, op1};

    var accumulator        : logic<ACC_WIDTH>  ;
    var next_accumulator   : logic<ACC_WIDTH>  ;
    var shifted_accumulator: logic<ACC_WIDTH>  ;
    var multiplicand       : logic<ACC_WIDTH>  ;
    var multiplicand3      : logic<ACC_WIDTH>  ;
    var multiplier         : logic<BOOTH_WIDTH>;
    var shifted_multiplier : logic<BOOTH_WIDTH>;
    var previous_bit       : logic             ;
    var high_saved         : logic             ;

    let product: logic<BOOTH_WIDTH * 2> = {shifted_accumulator[0+:BOOTH_WIDTH], shifted_multiplier};

    always_comb {
        next_accumulator = accumulator;
        case {multiplier[2:0], previous_bit} {
            4'b0001, 4'b0010: next_accumulator += multiplicand;
            4'b0011, 4'b0100: next_accumulator += multiplicand << 1;
            4'b0101, 4'b0110: next_accumulator += multiplicand3;
            4'b0111         : next_accumulator += multiplicand << 2;
            4'b1000         : next_accumulator -= multiplicand << 2;
            4'b1001, 4'b1010: next_accumulator -= multiplicand3;
            4'b1011, 4'b1100: next_accumulator -= multiplicand << 1;
            4'b1101, 4'b1110: next_accumulator -= multiplicand;
            default         : {}
        }
        shifted_accumulator = {next_accumulator[msb] repeat 3, next_accumulator[ACC_WIDTH - 1:3]};
        shifted_multiplier  = {next_accumulator[2:0], multiplier[BOOTH_WIDTH - 1:3]};
    }

    var add_count: logic<6>;

    always_ff {
        if_reset {
            state         = State::Idle;
            add_count     = 0;
            accumulator   = 0;
            multiplicand  = 0;
            multiplicand3 = 0;
            multiplier    = 0;
            previous_bit  = 0;
            high_saved    = 0;
            rvalid        = 0;
            result        = 0;
            low_zero      = 0;
        } else {
            rvalid = 0; // default
            case state {
                State::Idle   : if valid {
                    state         = State::AddLoop;
                    add_count     = 0;
                    accumulator   = 0;
                    multiplicand  = extended_op1;
                    multiplicand3 = extended_op1 + (extended_op1 << 1);
                    multiplier    = {1'b0 repeat BOOTH_WIDTH - WIDTH, op2};
                    previous_bit  = 0;
                    high_saved    = high;
                }
                State::AddLoop: {
                    accumulator  = shifted_accumulator;
                    multiplier   = shifted_multiplier;
                    previous_bit = multiplier[2];

                    if add_count == ITERATIONS[0+:6] - 1 {
                        state    = State::Idle;
                        rvalid   = 1;
                        result   = if high_saved ? product[WIDTH+:WIDTH] : product[0+:WIDTH];
                        low_zero = product[0+:WIDTH] == 0;
                    }
                    add_count += 1;
                }
                default: {}
            }
        }
    }
}

module divunit #(
    param WIDTH: u32 = XLEN,
) (
    clk      : input  clock       ,
    rst      : input  reset       ,
    valid    : input  logic       ,
    dividend : input  logic<WIDTH>,
    divisor  : input  logic<WIDTH>,
    rvalid   : output logic       ,
    quotient : output logic<WIDTH>,
    remainder: output logic<WIDTH>,
) {
    enum State {
        Idle,
        SubLoop,
    }

    var state: State;

    const REM_WIDTH : u32 = WIDTH + 2;
    const ITERATIONS: u32 = WIDTH / 2;

    var dividend_saved      : logic<WIDTH>    ;
    var divisor_saved       : logic<REM_WIDTH>;
    var thrice_divisor_saved: logic<REM_WIDTH>;
    var remainder_saved     : logic<REM_WIDTH>;
    var shifted_remainder   : logic<REM_WIDTH>;
    var twice_divisor       : logic<REM_WIDTH>;
    var next_remainder      : logic<REM_WIDTH>;
    var quotient_digit      : logic<2>        ;
    var next_quotient       : logic<WIDTH>    ;

    always_comb {
        remainder         = remainder_saved[0+:WIDTH];
        shifted_remainder = {remainder_saved[0+:WIDTH], dividend_saved[WIDTH - 1:WIDTH - 2]};
        twice_divisor     = divisor_saved << 1;

        if shifted_remainder >= thrice_divisor_saved {
            quotient_digit = 3;
            next_remainder = shifted_remainder - thrice_divisor_saved;
        } else if shifted_remainder >= twice_divisor {
            quotient_digit = 2;
            next_remainder = shifted_remainder - twice_divisor;
        } else if shifted_remainder >= divisor_saved {
            quotient_digit = 1;
            next_remainder = shifted_remainder - divisor_saved;
        } else {
            quotient_digit = 0;
            next_remainder = shifted_remainder;
        }
        next_quotient = {quotient[WIDTH - 3:0], quotient_digit};
    }

    var sub_count: logic<6>;

    always_ff {
        if_reset {
            state                = State::Idle;
            quotient             = 0;
            sub_count            = 0;
            dividend_saved       = 0;
            divisor_saved        = 0;
            thrice_divisor_saved = 0;
            remainder_saved      = 0;
            rvalid               = 0;
        } else {
            rvalid = 0; // default
            case state {
                State::Idle   : if valid {
                    if divisor == 0 {
                        state           = State::Idle;
                        quotient        = '1;
                        remainder_saved = {2'b00, dividend};
                        rvalid          = 1;
                    } else {
                        state                = State::SubLoop;
                        dividend_saved       = dividend;
                        divisor_saved        = {2'b00, divisor};
                        thrice_divisor_saved = {2'b00, divisor} + {1'b0, divisor, 1'b0};
                        remainder_saved      = 0;
                        quotient             = 0;
                        sub_count            = 0;
                    }
                }
                State::SubLoop: {
                    dividend_saved  <<= 2;
                    remainder_saved =   next_remainder;
                    quotient        =   next_quotient;

                    if sub_count == ITERATIONS[0+:6] - 1 {
                        state  = State::Idle;
                        rvalid = 1;
                    }
                    sub_count += 1;
                }
                default: {}
            }
        }
    }
}
