import eei::*;

// 遅いので 4 つまとめて出す
// 描画回路を流用
module graphics_mmio (
    clk       : input   clock        ,
    rst       : input   reset        ,
    membus    : modport Membus::slave,
    link_ready: input   logic        ,
    link_sclk : output  logic        ,
    link_mosi : output  logic        ,
    link_cs_n : output  logic        ,
) {
    // commands
    const OP_CLEAR      : logic<8> = 8'h01;
    const OP_FILL_RECT  : logic<8> = 8'h02;
    const OP_UPLOAD_RECT: logic<8> = 8'h03;
    const OP_SET_PALETTE: logic<8> = 8'h04;
    const OP_PRESENT    : logic<8> = 8'h05;

    const REG_STATUS : logic<3> = 3'd0;
    const REG_COMMAND: logic<3> = 3'd1;
    const REG_X      : logic<3> = 3'd2;
    const REG_Y      : logic<3> = 3'd3;
    const REG_W      : logic<3> = 3'd4;
    const REG_H      : logic<3> = 3'd5;
    const REG_COLOR  : logic<3> = 3'd6;
    const REG_DATA   : logic<3> = 3'd7;

    const HALF_PERIOD_CYCLES: logic<16> = 16'd2;
    const BYTE_GUARD_HALVES : logic<8>  = 8'd1;

    enum TxState: logic {
        Idle,
        Send,
    }

    // READY の sync
    var ready_sync: logic<3>;
    always_ff {
        if_reset {
            ready_sync = 3'b000;
        } else {
            ready_sync = {ready_sync[1:0], link_ready};
        }
    }
    let ready: logic = ready_sync[2];

    var reg_x    : logic<32>;
    var reg_y    : logic<32>;
    var reg_w    : logic<32>;
    var reg_h    : logic<32>;
    var reg_color: logic<32>;

    var state               : TxState    ;
    var active_command      : logic  <8> ;
    var command_arg         : logic  <8> ;
    var byte_index          : logic  <4> ;
    var bit_index           : logic  <3> ;
    var half_count          : logic  <16>;
    var low_guard           : logic  <8> ;
    var current_byte        : logic  <8> ;
    var load_pending        : logic      ;
    var upload_x            : logic  <16>;
    var upload_y            : logic  <16>;
    var data_byte_index     : logic  <2> ;
    var palette_entries_left: logic  <16>;
    var palette_channel     : logic  <2> ;

    var data_word : logic<32>;
    var data_valid: logic    ;
    var error     : logic    ;

    var response_pending: logic                   ;
    var response_rdata  : logic<MEMBUS_DATA_WIDTH>;

    let register_index: logic<3>  = membus.addr[4:2];
    let write_data32  : logic<32> = if membus.addr[2] ? membus.wdata[63:32] : membus.wdata[31:0];
    let busy          : logic     = state != TxState::Idle;
    let stream_command: logic     = active_command == OP_UPLOAD_RECT || active_command == OP_SET_PALETTE;
    let data_ready    : logic     = busy && stream_command && !data_valid;

    function command_is_valid (
        command: input logic<8>,
    ) -> logic {
        return command == OP_CLEAR || command == OP_FILL_RECT || command == OP_UPLOAD_RECT || command == OP_SET_PALETTE
            || command == OP_PRESENT;
    }

    function is_stream_index (
        index: input logic<4>,
    ) -> logic {
        return (active_command == OP_UPLOAD_RECT && index == 4'd12)
            || (active_command == OP_SET_PALETTE && index == 4'd6);
    }

    function packet_byte_available (
        index: input logic<4>,
    ) -> logic {
        return !is_stream_index(index) || data_valid;
    }

    function packet_byte (
        index: input logic<4>,
    ) -> logic<8> {
        if index == 4'd0 {
            return 8'h47;
        } else if index == 4'd1 {
            return 8'h50;
        } else if index == 4'd2 {
            return active_command;
        }

        // command
        case active_command {
            OP_CLEAR                    : return reg_color[7:0];
            OP_FILL_RECT, OP_UPLOAD_RECT: case index {
                4'd3   : return reg_x[7:0];
                4'd4   : return reg_x[15:8];
                4'd5   : return reg_y[7:0];
                4'd6   : return reg_y[15:8];
                4'd7   : return reg_w[7:0];
                4'd8   : return reg_w[15:8];
                4'd9   : return reg_h[7:0];
                4'd10  : return reg_h[15:8];
                4'd11  : return if active_command == OP_FILL_RECT ? reg_color[7:0] : command_arg;
                default: case data_byte_index {
                    2'd0   : return data_word[7:0];
                    2'd1   : return data_word[15:8];
                    2'd2   : return data_word[23:16];
                    default: return data_word[31:24];
                }
            }
            OP_SET_PALETTE: case index {
                4'd3   : return reg_x[7:0];
                4'd4   : return reg_w[7:0];
                4'd5   : return reg_w[15:8];
                default: case palette_channel {
                    2'd0   : return data_word[23:16];
                    2'd1   : return data_word[15:8];
                    default: return data_word[7:0];
                }
            }
            OP_PRESENT: return command_arg;
            default   : return 8'd0;
        }
    }

    function packet_byte_msb (
        index: input logic<4>,
    ) -> logic {
        let value: logic<8> = packet_byte(index);
        return value[7];
    }

    function is_last_packet_byte () -> logic {
        case active_command {
            OP_CLEAR      : return byte_index == 4'd3;
            OP_FILL_RECT  : return byte_index == 4'd11;
            OP_UPLOAD_RECT: {
                if byte_index == 4'd11 {
                    return reg_w[15:0] == 16'd0 || reg_h[15:0] == 16'd0;
                }
                return byte_index == 4'd12 && upload_x + 16'd1 == reg_w[15:0] && upload_y + 16'd1 == reg_h[15:0];
            }
            OP_SET_PALETTE: {
                if byte_index == 4'd5 {
                    return reg_w[15:0] == 16'd0;
                }
                return byte_index == 4'd6 && palette_entries_left == 16'd1 && palette_channel == 2'd2;
            }
            OP_PRESENT: return byte_index == 4'd3;
            default   : return 1;
        }
    }

    function status_value () -> logic<32> {
        var value      : logic<32>;
        value       = 32'd0;
        value[0]    = !busy && ready;
        value[1]    = busy;
        value[2]    = ready;
        value[3]    = data_ready;
        value[4]    = error;
        value[15:8] = active_command;
        return value;
    }

    function register_value (
        index: input logic<3>,
    ) -> logic<32> {
        return case index {
            REG_STATUS : status_value(),
            REG_COMMAND: {16'd0, command_arg, active_command},
            REG_X      : reg_x,
            REG_Y      : reg_y,
            REG_W      : reg_w,
            REG_H      : reg_h,
            REG_COLOR  : reg_color,
            REG_DATA   : data_word,
            default    : 32'd0,
        };
    }

    function aligned_read_data (
        value: input logic<32>,
        upper: input logic    ,
    ) -> logic<MEMBUS_DATA_WIDTH> {
        return if upper ? {value, 32'd0} : {32'd0, value};
    }

    // second DATA write
    always_comb {
        membus.ready  = !response_pending;
        membus.rvalid = response_pending;
        membus.rdata  = response_rdata;
        if membus.valid && membus.wen && register_index == REG_COMMAND && busy {
            membus.ready = 0;
        }
        if membus.valid && membus.wen && register_index == REG_DATA && busy && stream_command && data_valid {
            membus.ready = 0;
        }
    }

    always_ff {
        if_reset {
            reg_x                = 32'd0;
            reg_y                = 32'd0;
            reg_w                = 32'd0;
            reg_h                = 32'd0;
            reg_color            = 32'd0;
            state                = TxState::Idle;
            active_command       = 8'd0;
            command_arg          = 8'd0;
            byte_index           = 4'd0;
            bit_index            = 3'd7;
            half_count           = 16'd0;
            low_guard            = 8'd0;
            current_byte         = 8'h47;
            load_pending         = 0;
            upload_x             = 16'd0;
            upload_y             = 16'd0;
            data_byte_index      = 2'd0;
            palette_entries_left = 16'd0;
            palette_channel      = 2'd0;
            data_word            = 32'd0;
            data_valid           = 0;
            error                = 0;
            response_pending     = 0;
            response_rdata       = 0;
            link_sclk            = 0;
            link_mosi            = 0;
            link_cs_n            = 1;
        } else {
            if response_pending {
                response_pending = 0;
            }

            if membus.valid && membus.ready {
                response_pending = 1;
                response_rdata   = aligned_read_data(register_value(register_index), membus.addr[2]);
                if membus.wen {
                    response_rdata = 0;
                    case register_index {
                        REG_COMMAND: {
                            error = 0;
                            if command_is_valid(write_data32[7:0]) {
                                active_command       = write_data32[7:0];
                                command_arg          = write_data32[15:8];
                                byte_index           = 4'd0;
                                bit_index            = 3'd7;
                                half_count           = 16'd0;
                                low_guard            = BYTE_GUARD_HALVES;
                                current_byte         = 8'h47;
                                load_pending         = 0;
                                upload_x             = 16'd0;
                                upload_y             = 16'd0;
                                data_byte_index      = 2'd0;
                                palette_entries_left = reg_w[15:0];
                                palette_channel      = 2'd0;
                                data_valid           = 0;
                                link_sclk            = 0;
                                link_mosi            = 0;
                                link_cs_n            = 0;
                                state                = TxState::Send;
                            } else {
                                error = 1;
                            }
                        }
                        REG_X    : reg_x     = write_data32;
                        REG_Y    : reg_y     = write_data32;
                        REG_W    : reg_w     = write_data32;
                        REG_H    : reg_h     = write_data32;
                        REG_COLOR: reg_color = write_data32;
                        REG_DATA : {
                            if busy && stream_command {
                                data_word  = write_data32;
                                data_valid = 1;
                            } else {
                                error = 1;
                            }
                        }
                        default: {}
                    }
                }
            }

            case state {
                TxState::Idle: {}
                TxState::Send: {
                    if half_count == HALF_PERIOD_CYCLES - 16'd1 {
                        half_count = 16'd0;
                        if !link_sclk {
                            if load_pending {
                                if packet_byte_available(byte_index) {
                                    current_byte = packet_byte(byte_index);
                                    link_mosi    = packet_byte_msb(byte_index);
                                    load_pending = 0;
                                    low_guard    = BYTE_GUARD_HALVES;
                                }
                            } else if low_guard != 8'd0 {
                                low_guard -= 8'd1;
                            } else if ready {
                                link_sclk = 1;
                            }
                        } else {
                            link_sclk = 0;
                            if bit_index == 3'd0 {
                                if is_last_packet_byte() {
                                    link_cs_n      = 1;
                                    link_mosi      = 0;
                                    active_command = 0;
                                    data_valid     = 0;
                                    state          = TxState::Idle;
                                } else {
                                    case active_command {
                                        OP_UPLOAD_RECT: {
                                            if byte_index <: 4'd11 {
                                                byte_index += 4'd1;
                                            } else if byte_index == 4'd11 {
                                                byte_index = 4'd12;
                                            } else {
                                                if data_byte_index == 2'd3 {
                                                    data_byte_index = 2'd0;
                                                    data_valid      = 0;
                                                } else {
                                                    data_byte_index += 2'd1;
                                                }
                                                if upload_x + 16'd1 == reg_w[15:0] {
                                                    upload_x =  16'd0;
                                                    upload_y += 16'd1;
                                                } else {
                                                    upload_x += 16'd1;
                                                }
                                            }
                                        }
                                        OP_SET_PALETTE: {
                                            if byte_index <: 4'd5 {
                                                byte_index += 4'd1;
                                            } else if byte_index == 4'd5 {
                                                byte_index = 4'd6;
                                            } else if palette_channel == 2'd2 {
                                                palette_channel      =  2'd0;
                                                palette_entries_left -= 16'd1;
                                                data_valid           =  0;
                                            } else {
                                                palette_channel += 2'd1;
                                            }
                                        }
                                        default: byte_index += 4'd1;
                                    }
                                    bit_index    = 3'd7;
                                    load_pending = 1;
                                }
                            } else {
                                bit_index -= 3'd1;
                                link_mosi =  current_byte[bit_index - 1'b1];
                            }
                        }
                    } else {
                        half_count += 16'd1;
                    }
                }
                default: state = TxState::Idle;
            }
        }
    }
}
