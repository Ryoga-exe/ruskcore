import eei::*;

module mmio_controller (
    clk       : input   clock         ,
    rst       : input   reset         ,
    DBG_ADDR  : input   Addr          ,
    req_core  : modport Membus::slave ,
    ram_membus: modport Membus::master,
    rom_membus: modport Membus::master,
    dbg_membus: modport Membus::master,
    gpu_membus: modport Membus::master,
) {
    enum Device {
        UNKNOWN,
        RAM,
        ROM,
        DEBUG,
        GRAPHICS,
    }

    struct Request {
        valid: logic                       ,
        addr : Addr                        ,
        wen  : logic                       ,
        wdata: logic<MEMBUS_DATA_WIDTH>    ,
        wmask: logic<MEMBUS_DATA_WIDTH / 8>,
    }

    let core_req     : Request = Request'{
        valid        : req_core.valid,
        addr         : req_core.addr ,
        wen          : req_core.wen  ,
        wdata        : req_core.wdata,
        wmask        : req_core.wmask,
    };
    let core_device  : Device  = get_device(req_core.addr);
    let core_accepted: logic   = req_core.ready && req_core.valid;

    var req_saved   : Request;
    var last_device : Device ;
    var is_requested: logic  ;

    let response_done: logic = req_saved.valid && is_requested && get_device_rvalid(last_device);
    let can_accept   : logic = !req_saved.valid || response_done;

    // reset master with 0
    function reset_membus_master (
        master: modport Membus::master,
    ) {
        master.valid = 0;
        master.addr  = 0;
        master.wen   = 0;
        master.wdata = 0;
        master.wmask = 0;
    }

    // Reset all device's master
    function reset_all_device_masters () {
        reset_membus_master(ram_membus);
        reset_membus_master(rom_membus);
        reset_membus_master(dbg_membus);
        reset_membus_master(gpu_membus);
    }

    // Get device from address
    function get_device (
        addr: input Addr,
    ) -> Device {
        if DBG_ADDR <= addr && addr <= DBG_ADDR + 7 {
            return Device::DEBUG;
        }
        if MMAP_GRAPHICS_BEGIN <= addr && addr <= MMAP_GRAPHICS_END {
            return Device::GRAPHICS;
        }
        if MMAP_ROM_BEGIN <= addr && addr <= MMAP_ROM_END {
            return Device::ROM;
        }
        if addr >= MMAP_RAM_BEGIN {
            return Device::RAM;
        }
        return Device::UNKNOWN;
    }

    // Assign req information to the device's master
    function assign_device_master (
        req: input Request,
    ) {
        case get_device(req.addr) {
            Device::RAM: {
                ram_membus.valid = req.valid;
                ram_membus.addr  = req.addr - MMAP_RAM_BEGIN;
                ram_membus.wen   = req.wen;
                ram_membus.wdata = req.wdata;
                ram_membus.wmask = req.wmask;
            }
            Device::ROM: {
                rom_membus.valid = req.valid;
                rom_membus.addr  = req.addr - MMAP_ROM_BEGIN;
                rom_membus.wen   = req.wen;
                rom_membus.wdata = req.wdata;
                rom_membus.wmask = req.wmask;
            }
            Device::DEBUG: {
                dbg_membus.valid = req.valid;
                dbg_membus.addr  = req.addr - DBG_ADDR;
                dbg_membus.wen   = req.wen;
                dbg_membus.wdata = req.wdata;
                dbg_membus.wmask = req.wmask;
            }
            Device::GRAPHICS: {
                gpu_membus.valid = req.valid;
                gpu_membus.addr  = req.addr - MMAP_GRAPHICS_BEGIN;
                gpu_membus.wen   = req.wen;
                gpu_membus.wdata = req.wdata;
                gpu_membus.wmask = req.wmask;
            }
            default: {}
        }
    }

    // Assign device rvalid and rdata to req
    function assign_device_slave (
        device: input   Device       ,
        req   : modport Membus::slave,
    ) {
        req.ready  = get_device_rvalid(device);
        req.rvalid = 1;
        req.rdata  = 0;
        case device {
            Device::RAM: {
                req.rvalid = ram_membus.rvalid;
                req.rdata  = ram_membus.rdata;
            }
            Device::ROM: {
                req.rvalid = rom_membus.rvalid;
                req.rdata  = rom_membus.rdata;
            }
            Device::DEBUG: {
                req.rvalid = dbg_membus.rvalid;
                req.rdata  = dbg_membus.rdata;
            }
            Device::GRAPHICS: {
                req.rvalid = gpu_membus.rvalid;
                req.rdata  = gpu_membus.rdata;
            }
            default: {}
        }
    }

    // Get device ready information
    function get_device_ready (
        device: input Device,
    ) -> logic {
        return case device {
            Device::RAM     : ram_membus.ready,
            Device::ROM     : rom_membus.ready,
            Device::DEBUG   : dbg_membus.ready,
            Device::GRAPHICS: gpu_membus.ready,
            default         : 1,
        };
    }

    // Get device's rvalid
    function get_device_rvalid (
        device: input Device,
    ) -> logic {
        return case device {
            Device::RAM     : ram_membus.rvalid,
            Device::ROM     : rom_membus.rvalid,
            Device::DEBUG   : dbg_membus.rvalid,
            Device::GRAPHICS: gpu_membus.rvalid,
            default         : 1,
        };
    }

    // Assign req_core
    always_comb {
        // default value
        req_core.ready  = 0;
        req_core.rvalid = 0;
        req_core.rdata  = 0;

        if req_saved.valid {
            if is_requested {
                // return result
                assign_device_slave(last_device, req_core);
            }
        } else {
            req_core.ready = 1;
        }
    }

    // Assign device's master
    always_comb {
        reset_all_device_masters();

        if req_saved.valid {
            if is_requested {
                if get_device_rvalid(last_device) {
                    // Accept new request
                    if req_core.ready && req_core.valid {
                        assign_device_master(core_req);
                    }
                }
            } else {
                // Assign req_saved to device
                assign_device_master(req_saved);
            }
        } else {
            // Accept new request
            if req_core.ready && req_core.valid {
                assign_device_master(core_req);
            }
        }
    }

    always_ff {
        if_reset {
            last_device  = Device::UNKNOWN;
            is_requested = 0;
            req_saved    = 0;
        } else {
            if req_saved.valid && !is_requested {
                is_requested = get_device_ready(last_device);
            }

            if can_accept {
                if core_accepted {
                    last_device  = core_device;
                    is_requested = get_device_ready(core_device);
                    req_saved    = core_req;
                } else {
                    req_saved.valid = 0;
                }
            }
        }
    }
}
