import eei::*;

module uart_mmio #(
    param CLK_FRE   : u32 = 50    , //clock frequency(Mhz)
    param BAUD_RATE : u32 = 115200, //serial baud rate
    param FIFO_WIDTH: u32 = 4     ,
) (
    clk   : input   clock        ,
    rst   : input   reset        ,
    membus: modport Membus::slave,
    rxd   : input   logic        ,
    txd   : output  logic        ,
) {
    const REG_RBR_THR: logic<12> = 12'h000;
    const REG_LSR    : logic<12> = 12'h005;

    var rx_data      : logic<8>;
    var rx_data_valid: logic   ;
    var rx_data_ready: logic   ;

    inst u_rx: uart_rx #(
        CLK_FRE    ,
        BAUD_RATE  ,
    ) (
        clk               ,
        rst               ,
        rx_data           ,
        rx_data_valid     ,
        rx_data_ready     ,
        rx_pin       : rxd,
    );

    var tx_data      : logic<8>;
    var tx_data_valid: logic   ;
    var tx_data_ready: logic   ;

    inst u_tx: uart_tx #(
        CLK_FRE    ,
        BAUD_RATE  ,
    ) (
        clk               ,
        rst               ,
        tx_data           ,
        tx_data_valid     ,
        tx_data_ready     ,
        tx_pin       : txd,
    );

    // RX FIFO: UART -> MMIO
    // read by MMIO RBR
    var rx_fifo_rdata : logic<8>;
    var rx_fifo_rvalid: logic   ;
    var rx_fifo_rready: logic   ;

    inst u_rx_fifo: fifo #(
        DATA_TYPE: logic<8>  ,
        WIDTH    : FIFO_WIDTH,
    ) (
        clk                       ,
        rst                       ,
        flush     : 0             ,
        wready    : rx_data_ready ,
        wready_two: _             ,
        wvalid    : rx_data_valid ,
        wdata     : rx_data       ,
        rready    : rx_fifo_rready,
        rvalid    : rx_fifo_rvalid,
        rdata     : rx_fifo_rdata ,
    );

    // TX FIFO: MMIO -> UART
    // written by MMIO THR
    var tx_fifo_wdata : logic<8>;
    var tx_fifo_wvalid: logic   ;
    var tx_fifo_wready: logic   ;

    inst u_tx_fifo: fifo #(
        DATA_TYPE: logic<8>  ,
        WIDTH    : FIFO_WIDTH,
    ) (
        clk                       ,
        rst                       ,
        flush     : 0             ,
        wready    : tx_fifo_wready,
        wready_two: _             ,
        wvalid    : tx_fifo_wvalid,
        wdata     : tx_fifo_wdata ,
        rready    : tx_data_ready ,
        rvalid    : tx_data_valid ,
        rdata     : tx_data       ,
    );

    // Membus request/response
    var pending   : logic;
    var addr_saved: Addr ;
    var wen_saved : logic;

    var resp_valid    : logic;
    var resp_data_calc: UIntX;

    var ready_calc: logic;

    always_comb {
        membus.ready  = ready_calc;
        membus.rvalid = resp_valid;
        membus.rdata  = resp_data_calc;
    }

    // RX FIFO pop
    always_comb {
        rx_fifo_rready = 0;
        if !pending && ready_calc && membus.valid && !membus.wen {
            let offset: logic<12> = membus.addr[11:0];
            if offset == REG_RBR_THR && !rx_fifo_rvalid {
                rx_fifo_rready = 1;
            }
        }
    }

    always_comb {
        resp_data_calc = 0;
        if resp_valid && !wen_saved {
            let offset: logic<12> = addr_saved[11:0];
            let bi    : logic<3>  = addr_saved[2:0];
            let sh    : logic<6>  = {bi, 3'b000};

            if offset == REG_RBR_THR {
                resp_data_calc = (rx_fifo_rdata as UIntX) << sh;
            } else if offset == REG_LSR {
                resp_data_calc = {1'b0, tx_data_ready, tx_fifo_wvalid, 1'b0, 1'b0, 1'b0, 1'b0, !rx_fifo_rready} as UIntX
                    << sh;
            }
        }
    }

    always_comb {
        ready_calc = !pending;

        if ready_calc && membus.valid {
            let offset: logic<12> = membus.addr[11:0];
            let bi    : logic<3>  = membus.addr[2:0];

            if membus.wen && (offset == REG_RBR_THR) {
                if membus.wmask[bi] && !tx_fifo_wvalid {
                    ready_calc = 0;
                }
            }
        }
    }

    always_ff {
        if_reset {
            pending    = 0;
            addr_saved = 0;
            wen_saved  = 0;

            resp_valid = 0;

            tx_fifo_wvalid = 0;
            tx_fifo_wdata  = 0;
        } else {
            resp_valid     = 0;
            tx_fifo_wvalid = 0;
            tx_fifo_wdata  = 0;

            // Response
            if pending {
                resp_valid = 1;
                pending    = 0;
            }

            // Accept
            if !pending && membus.valid && membus.ready {
                let offset: logic<12> = membus.addr[11:0];
                let bi    : logic<3>  = membus.addr[2:0];

                pending    = 1;
                addr_saved = membus.addr;
                wen_saved  = membus.wen;

                if membus.wen {
                    // THR write
                    if offset == REG_RBR_THR {
                        if membus.wmask[bi] && tx_fifo_wready {
                            tx_fifo_wvalid = 1;
                            tx_fifo_wdata  = case bi {
                                0      : membus.wdata[7:0],
                                1      : membus.wdata[15:8],
                                2      : membus.wdata[23:16],
                                3      : membus.wdata[31:24],
                                4      : membus.wdata[39:32],
                                5      : membus.wdata[47:40],
                                6      : membus.wdata[55:48],
                                7      : membus.wdata[63:56],
                                default: 8'h00,
                            };
                        }
                    }
                } else {
                    // RBR
                }
            }
        }
    }
}
