import eei::*;

module top_tang #(
    param RESET_ACTIVE_HIGH: bit = 1,
) (
    clk: input  clock   ,
    rst: input  logic   ,
    led: output logic<6>,
    // uart
    uart_rxd: input  logic,
    uart_txd: output logic,
    // graphics
    link_ready: input  logic,
    link_sclk : output logic,
    link_mosi : output logic,
    link_cs_n : output logic,
) {
    let core_rst: reset = if RESET_ACTIVE_HIGH ? !rst : rst;

    // CSRの下位ビットをLEDに接続する
    var led_top: UIntX;
    always_comb {
        led = led_top[5:0];
    }

    inst t: top #(
        RAM_FILEPATH_IS_ENV: 0                 ,
        RAM_FILEPATH       : "test/zig/gpu.hex",
        ROM_FILEPATH_IS_ENV: 0                 ,
        ROM_FILEPATH       : "bootrom.hex"     ,
    ) (
        #[ifdef(TEST_MODE)]
        test_success : _       ,
        MMAP_DBG_ADDR: 0       ,
        clk                    ,
        rst          : core_rst,
        led          : led_top ,
        uart_rxd               ,
        uart_txd               ,
        link_ready             ,
        link_sclk              ,
        link_mosi              ,
        link_cs_n              ,
    );
}
