import eei::*;

module top_tang #(
    param RESET_ACTIVE_HIGH: bit = 0,
) (
    clk: input  clock   ,
    rst: input  logic   ,
    led: output logic<6>,
) {
    let core_rst: reset = if RESET_ACTIVE_HIGH ? !rst : rst;

    // CSRの下位ビットをLEDに接続する
    var led_top: UIntX;
    always_comb {
        led = led_top[5:0];
    }

    inst t: top #(
        RAM_FILEPATH_IS_ENV: 0                     ,
        RAM_FILEPATH       : "test/led_counter.hex",
    ) (
        #[ifdef(TEST_MODE)]
        test_success : _       ,
        MMAP_DBG_ADDR: 0       ,
        clk                    ,
        rst          : core_rst,
        led          : led_top ,
    );
}
